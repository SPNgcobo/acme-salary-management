    {
      "name": "10 - Get current salary (expect 2026-01-01 record)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.test('current salary is the 2026-01-01 record', function () {",
              "        pm.expect(body.effectiveDate).to.equal('2026-01-01');",
              "        pm.expect(body.amount).to.eql(55000.00);",
              "        pm.expect(body.currencyCode).to.equal('GBP');",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/employees/{{employeeId}}/salaries/current",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "employees",
            "{{employeeId}}",
            "salaries",
            "current"
          ]
        },
        "description": "Current salary is the latest effective record on or before today. The 2030 record must not appear."
      },
      "response": []
    },
    {
      "name": "11 - List salary history (default sort, expect 3 records)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.test('3 salary records', function () { pm.expect(body.content.length).to.eql(3); });",
              "    pm.test('ordered 2030 -> 2026 -> 2025', function () {",
              "        pm.expect(body.content[0].effectiveDate).to.equal('2030-01-01');",
              "        pm.expect(body.content[1].effectiveDate).to.equal('2026-01-01');",
              "        pm.expect(body.content[2].effectiveDate).to.equal('2025-01-01');",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/employees/{{employeeId}}/salaries",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "employees",
            "{{employeeId}}",
            "salaries"
          ]
        },
        "description": "History is paginated with default sort effectiveDate descending. The three seeded records appear in that order."
      },
      "response": []
    },

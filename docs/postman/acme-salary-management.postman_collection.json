{
  "info": {
    "_postman_id": "7b6c2597-761f-4b04-8587-72166a5a62e2",
    "name": "ACME Salary Management",
    "description": "Smoke tests for the ACME Salary Management API. Run in order.\n\n- Requests 01-06 exercise the employee module.\n- Requests 07-17 exercise the salary module.\n- Request 02 sets the collection variable `employeeId` from its response, so downstream requests use the created employee.\n- If you re-run the whole collection against the same database, the create endpoints will return 409 Conflict on the second run because employee numbers, emails, and (employee_id, effective_date) pairs must be unique. This is expected: the collection is a persistence test, not an idempotent fixture. To run cleanly a second time, use a different Postgres database or delete the test rows manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "42565763"
  },
  "item": [
    {
      "name": "01 - List employees (initial state)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('body has content array', function () { pm.expect(pm.response.json()).to.have.property('content'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/employees",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "employees"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Create employee Ada Lovelace (sets employeeId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('employeeId', body.id);",
              "    console.log('Captured employeeId =', body.id);",
              "} else if (pm.response.code === 409) {",
              "    console.log('Employee already exists. Use 03 to fetch by id or reset the database.');",
              "}",
              "pm.test('status is 201 or 409', function () { pm.expect([201, 409]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeNumber\": \"EMP-SALARY-01\",\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper\",\n  \"email\": \"grace.hopper@acme.test\",\n  \"countryCode\": \"US\",\n  \"department\": \"Engineering\",\n  \"employmentStatus\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/employees",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Creates the employee used by the salary requests. A test script captures the returned id into the collection variable `employeeId`."
      },
      "response": []
    },

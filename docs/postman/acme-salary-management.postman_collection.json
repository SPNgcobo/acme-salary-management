        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeNumber\": \"EMP-SALARY-01\",\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper\",\n  \"email\": \"grace.hopper@acme.test\",\n  \"countryCode\": \"US\",\n  \"department\": \"Engineering\",\n  \"employmentStatus\": \"ACTIVE\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8080/api/employees",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees"]
        },
        "description": "Requires request 02 to have succeeded on this or a previous run (so the row exists). EmployeeService.create pre-checks existsByEmployeeNumber and throws DuplicateEmployeeException, mapped to 409 by GlobalExceptionHandler."
      },
      "response": []
    },

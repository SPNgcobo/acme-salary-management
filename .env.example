# Copy this file to backend/.env and fill in your local values.
# PowerShell: Copy-Item .env.example backend/.env
# Bash:       cp .env.example backend/.env
#
# Never commit backend/.env.
# Only this template should be committed.
#
# Quote values containing special characters or whitespace where required
# by the dotenv parser. Check the parser's rules if values are not loaded.

# --- Backend database configuration ---
DB_URL=jdbc:postgresql://localhost:5432/acme_salary_management
DB_USERNAME=acme_app
DB_PASSWORD="change-me"

# --- JWT configuration ---
# Replace this placeholder with a securely generated random secret.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRATION_MS=86400000

# --- Spring profile ---
# Local development only.
# The dev profile permits unauthenticated requests and disables CSRF.
SPRING_PROFILES_ACTIVE=dev

# Production must set SPRING_PROFILES_ACTIVE=prod through the hosting
# platform's environment configuration. Never use the dev profile in prod.

# --- Frontend configuration ---
# Used when the Angular frontend is implemented and configured to read it.
NG_APP_API_BASE_URL=http://localhost:8080/api